#!/usr/bin/env python3

"""Read what a window can do, and run one of the entries in its app.

Entries come from, in order:
  1. the app's menu bar (File > Save As...), read from the accessibility tree
  2. the actions a GTK app exports over D-Bus (New Tab, Toggle Sidebar, ...)
  3. the window's named buttons, when the app has no menu bar
  4. a menu the app only draws once one of those buttons is pressed, when the
     menu asks for it to be opened

  search-menu-items --serve   what SearchMenuItems.qml runs: entries as JSON
                              lines on stdout, commands on stdin
  search-menu-items --print   list the entries

Both read the focused window, or the one named by --window <address>.
--debug says on stderr what was found where, and how long it took.

Everything is asked over D-Bus a whole level at a time, not one call after
another: an app answers a few thousand calls sent together in a fraction of
the time it takes to wait for each in turn.
"""

from __future__ import annotations

import argparse
import json
import logging
import os
import re
import signal
import subprocess
import sys
import time
import xml.etree.ElementTree as ElementTree
from pathlib import Path
from dataclasses import dataclass, field
from functools import partial
from typing import Callable, Iterator, NamedTuple

from gi.repository import Gio, GLib

try:
    from gi.repository import GLibUnix

    unix_signal_add = GLibUnix.signal_add
except ImportError:  # GLib before 2.80
    unix_signal_add = GLib.unix_signal_add

log = logging.getLogger("search-menu-items")

ACCESSIBLE = "org.a11y.atspi.Accessible"
ACTION = "org.a11y.atspi.Action"
APPLICATION = "org.a11y.atspi.Application"
GTK_ACTIONS = "org.gtk.Actions"
INTROSPECTABLE = "org.freedesktop.DBus.Introspectable"
PROPERTIES = "org.freedesktop.DBus.Properties"

# AT-SPI role and state numbers (atspi-constants.h).
MENU, MENU_BAR, POPUP_MENU = 33, 34, 41
MENU_ROLES = {MENU, POPUP_MENU}
ITEM_ROLES = {8, 35, 45}  # check menu item, menu item, radio menu item
CONTROL_ROLES = ITEM_ROLES | {43, 62, 129}  # push button, toggle button, push button menu
# Page content is not part of the app's own interface, and can be huge.
CONTENT_ROLES = {60, 82, 92, 93, 94, 95, 96}  # terminal and the document roles
WEB_PAGE = 95  # document web
TEXT_ROLES = {29, 83, 116}  # label, heading, static text
# What a dialog holds and a menu does not: check box, combo box, dialog,
# password text, radio button, slider, spin button, entry.
FORM_ROLES = {7, 11, 16, 40, 44, 51, 52, 79}
ACTIVE, CHECKED, ENABLED, PRESSED, SENSITIVE, SHOWING = 1, 4, 8, 20, 24, 25

MAX_DEPTH = 12
MAX_NODES = 6000
READ_BUDGET = 2.0  # seconds, per source
CALL_TIMEOUT = 1500  # milliseconds
ACTIONS_TIMEOUT = 300  # milliseconds; a connection without actions may not answer at all
RUN_TIMEOUT = 2000  # milliseconds
IDLE_TIMEOUT = 300  # seconds before a forgotten reader exits
BATCH = 100  # entries per line, so a line stays a few kilobytes
RUN_DELAY = 60  # milliseconds for the menu to close before an entry runs
# A page answers a press before it has drawn anything, so a menu is waited
# for: Obsidian starts one within 25 ms and has it whole within 80.
LAYER_WAIT = 0.15  # seconds a pressed button has to start drawing its menu
MENU_WAIT = 0.25  # seconds it has to finish it
MENU_POLL = 0.01  # seconds between looks for it
MENU_NODES = 1000
# Close, Minimize, Maximize and Restore: the most buttons a window has that
# are its frame's and not its app's.
FRAME_BUTTONS = 4
ESCAPE_WAIT = 0.03  # seconds for an app to take a menu down

MODIFIERS = {
    "<Primary>": "Ctrl+",
    "<Control>": "Ctrl+",
    "<Ctrl>": "Ctrl+",
    "<Shift>": "Shift+",
    "<Alt>": "Alt+",
    "<Super>": "Super+",
    "<Meta>": "Meta+",
}
MODIFIER_ORDER = ["Super", "Meta", "Ctrl", "Alt", "Shift"]

ACCESSIBILITY_FLAG = "--force-renderer-accessibility"

EXPECTED_ERRORS = {
    "org.freedesktop.DBus.Error.UnknownMethod",
    "org.freedesktop.DBus.Error.UnknownInterface",
    "org.freedesktop.DBus.Error.UnknownObject",
}

# Why an entry is listed but not run, when the app itself did not grey it out.
SEVERAL_WINDOWS = "Several windows are open; which one is not known"
SAME_TITLE = "Another window has the same title; which one is not known"

Emit = Callable[[dict], None]


# --- What is read ------------------------------------------------------------


class Ref(NamedTuple):
    """Where an object lives on a bus."""

    bus: str
    path: str


DBUS = Ref("org.freedesktop.DBus", "/org/freedesktop/DBus")
REGISTRY = Ref("org.a11y.atspi.Registry", "/org/a11y/atspi/accessible/root")


@dataclass
class Node:
    """One object of the accessibility tree, as far as it was asked about."""

    children: list[Ref] = field(default_factory=list)
    role: int = -1
    state: int = 0
    name: str = ""
    key: str = ""  # the shortcut, as the toolkit spells it
    actions: int = 0
    press: str = ""  # what its first action is called

    def has(self, state: int) -> bool:
        return bool(self.state >> state & 1)

    @property
    def label(self) -> str:
        return clean(self.name)

    @property
    def usable(self) -> bool:
        return self.actions > 0 and (self.has(ENABLED) or self.has(SENSITIVE))


@dataclass(frozen=True)
class Press:
    """Run by pressing an item or a button of the accessibility tree."""

    ref: Ref
    # The web page it is on, when that page is the app's whole interface. Such
    # a page draws a menu only once its button is pressed, so pressing may
    # open one.
    page: Ref | None = None


@dataclass(frozen=True)
class GtkAction:
    """Run by activating an action a GTK app exports."""

    bus: str
    path: str
    name: str


@dataclass
class Entry:
    id: int
    path: list[str]  # the menus it is in: ["File", "Export As"]
    label: str
    kind: str  # "menu", "action" or "button"
    target: Press | GtkAction
    key: str = ""
    enabled: bool = True  # False when the app has greyed it out
    checked: bool = False
    why: str = ""  # set when it is listed for information only
    place: str = ""  # the part of the window it is in, when its label is not the only one

    @property
    def runnable(self) -> bool:
        return self.enabled and not self.why

    @property
    def opens(self) -> bool:
        """Whether running it may open a menu to read."""
        return isinstance(self.target, Press) and self.target.page is not None

    def message(self) -> dict:
        message = {"id": self.id, "path": self.path, "label": self.label, "key": self.key, "kind": self.kind}
        if not self.runnable:
            message["off"] = True
        if self.why:
            message["why"] = self.why
        if self.checked:
            message["on"] = True
        if self.opens:
            message["opens"] = True
        if self.place:
            message["place"] = self.place
        return message


class Entries:
    """Every entry read so far. An entry's id is its position, which is what
    the menu sends back to have it run."""

    def __init__(self, emit: Emit):
        self.emit = emit
        self.all: list[Entry] = []
        self.sent = 0

    def add(self, path: list[str], label: str, kind: str, target: Press | GtkAction, *,
            key: str = "", enabled: bool = True, checked: bool = False, why: str = "") -> None:
        self.all.append(Entry(len(self.all), path, label, kind, target, key, enabled, checked, why))

    def fresh(self) -> list[Entry]:
        """What was added since the last time."""
        fresh = self.all[self.sent:]
        self.sent = len(self.all)
        return fresh

    def flush(self) -> int:
        """Sends what was added since the last time; says how many that was."""
        fresh = self.fresh()
        for start in range(0, len(fresh), BATCH):
            self.emit({"t": "items", "items": [entry.message() for entry in fresh[start:start + BATCH]]})
        return len(fresh)


def to_stdout(message: dict) -> None:
    sys.stdout.write(json.dumps(message, ensure_ascii=False, separators=(",", ":")) + "\n")
    sys.stdout.flush()


def to_nowhere(message: dict) -> None:
    pass


# --- Text --------------------------------------------------------------------


def clean(text: str) -> str:
    """One line, without the tooltip some toolkits append to a button's name."""
    text = " ".join((text or "").replace("\t", " ").split())
    return text if len(text) <= 70 else text[:69].rstrip() + "…"


def shortcut(binding: str) -> str:
    """"Ctrl+Shift+S" from what a toolkit reports: GTK gives "mnemonic;full
    mnemonic path;accelerator", Qt the accelerator alone."""
    binding = binding or ""
    accelerator = binding.split(";")[-1]
    # Without an accelerator Qt reports the item's Alt+letter mnemonic, which
    # only works while its menu is open.
    if not accelerator or (";" not in binding and re.fullmatch(r"Alt\+.", accelerator)):
        return ""
    for token, name in MODIFIERS.items():
        accelerator = accelerator.replace(token, name)
    if accelerator.endswith("+"):  # the key is "+" itself
        held, key = [name for name in accelerator[:-1].split("+") if name], "+"
    else:
        *held, key = accelerator.split("+")
    held.sort(key=lambda name: MODIFIER_ORDER.index(name) if name in MODIFIER_ORDER else len(MODIFIER_ORDER))
    return "+".join(held + [key.upper() if len(key) == 1 else key.capitalize()])


HELD = r"(?:(?:Ctrl|Alt|Shift|Super|Meta|Cmd)\+)"
CHORD = rf"(?:{HELD}+\S+|F\d{{1,2}})"
SHORTCUT_AT_END = re.compile(rf"^(.+?) (?:\(({CHORD}(?: {CHORD})*)\)|({HELD}+\S+(?: {CHORD})*))$")


def split_shortcut(text: str) -> tuple[str, str]:
    """("Settings", "Ctrl+,") from "Settings Ctrl+," or "Settings (Ctrl+,)":
    a page has nowhere but the name to put a shortcut."""
    found = SHORTCUT_AT_END.match(text)
    return (found[1], found[2] or found[3]) if found else (text, "")


def humanize(action: str) -> str:
    """"Toggle sidebar" from "toggle-sidebar"."""
    words = re.sub(r"[-_.]+", " ", action).strip()
    return words[:1].upper() + words[1:]


# --- Hyprland ----------------------------------------------------------------


def hyprctl(*arguments: str):
    try:
        out = subprocess.run(["hyprctl", *arguments, "-j"], capture_output=True, text=True, timeout=3).stdout
        return json.loads(out)
    except (OSError, ValueError, subprocess.TimeoutExpired) as error:
        log.debug("hyprctl %s failed: %s", " ".join(arguments), error)
        return None


def find_window(address: str) -> dict:
    """The window with that address, or the focused one when none is given."""
    if address:
        wanted = address.lower().removeprefix("0x")
        for window in hyprctl("clients") or []:
            if str(window.get("address", "")).lower().removeprefix("0x") == wanted:
                return window
    return hyprctl("activewindow") or {}


# --- D-Bus -------------------------------------------------------------------


class Batch:
    """Sends many calls on one connection and waits for all the answers."""

    def __init__(self, connection: Gio.DBusConnection, timeout: int = CALL_TIMEOUT):
        self.connection = connection
        self.timeout = timeout
        self.loop = GLib.MainLoop()
        self.pending = 0

    def call(self, ref: Ref, interface: str, method: str, arguments: GLib.Variant | None,
             done: Callable[[tuple | None], None]) -> None:
        """`done` gets the reply, or None when there was none."""
        self.pending += 1

        def finished(connection, result):
            try:
                reply = connection.call_finish(result).unpack()
            except GLib.Error as error:
                # Most objects lack one interface or another; only say what is not that.
                if (Gio.DBusError.get_remote_error(error) or "") not in EXPECTED_ERRORS:
                    log.debug("%s.%s on %s %s: %s", interface, method, ref.bus, ref.path, error.message)
                reply = None
            done(reply)
            self.pending -= 1
            if self.pending == 0:
                self.loop.quit()

        self.connection.call(
            ref.bus, ref.path, interface, method, arguments, None,
            Gio.DBusCallFlags.NONE, self.timeout, None, finished,
        )

    def wait(self) -> None:
        if self.pending:
            self.loop.run()


def accessibility_bus(session: Gio.DBusConnection) -> Gio.DBusConnection:
    address = session.call_sync(
        "org.a11y.Bus", "/org/a11y/bus", "org.a11y.Bus", "GetAddress",
        None, GLib.VariantType("(s)"), Gio.DBusCallFlags.NONE, 1000, None,
    ).unpack()[0]
    return Gio.DBusConnection.new_for_address_sync(
        address,
        Gio.DBusConnectionFlags.AUTHENTICATION_CLIENT | Gio.DBusConnectionFlags.MESSAGE_BUS_CONNECTION,
        None, None,
    )


def accessibility_enabled(session: Gio.DBusConnection) -> bool:
    """Most toolkits only publish their interface once this is on."""
    try:
        value = session.call_sync(
            "org.a11y.Bus", "/org/a11y/bus", PROPERTIES, "Get",
            GLib.Variant("(ss)", ("org.a11y.Status", "IsEnabled")),
            GLib.VariantType("(v)"), Gio.DBusCallFlags.NONE, 1000, None,
        ).unpack()[0]
        return bool(value)
    except GLib.Error:
        return True


def enable_accessibility() -> None:
    # The setting lasts across sessions; the bus property applies it to this one.
    subprocess.run(
        ["gsettings", "set", "org.gnome.desktop.interface", "toolkit-accessibility", "true"],
        capture_output=True, check=False,
    )
    subprocess.run(
        ["busctl", "--user", "set-property", "org.a11y.Bus", "/org/a11y/bus",
         "org.a11y.Status", "IsEnabled", "b", "true"],
        capture_output=True, check=False,
    )


# --- The flag a Chromium app needs -------------------------------------------


class Launcher(NamedTuple):
    """How an Arch package starts a Chromium app: the program that runs, the
    script that starts it, and the file of flags that script reads."""

    program: str  # a pattern for /proc/<pid>/exe
    script: str
    flags: str  # in ~/.config
    # A setting to add to the app's own settings with the flag: where, in
    # ~/.config, its name and its value.
    setting: tuple[str, str, str] | None = None
    note: str = ""


LAUNCHERS = [
    Launcher(r"/usr/lib/(electron\d*)/electron", r"/usr/bin/\1", "electron-flags.conf"),
    # With the flag VS Code takes a screen reader to be running, and changes
    # how its editor behaves unless it is told there is none.
    Launcher(r"/usr/share/code/code|/opt/visual-studio-code/code", "/usr/bin/code", "code-flags.conf",
             ("Code/User/settings.json", "editor.accessibilitySupport", "off"),
             "Also keeps its screen reader mode off, in its settings."),
    Launcher(r"/usr/lib/chromium/chromium", "/usr/bin/chromium", "chromium-flags.conf"),
]


def config_path(name: str) -> str:
    return os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), name)


def flag_set(pid: int) -> bool:
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as file:
            return ACCESSIBILITY_FLAG.encode() in file.read().split(b"\0")
    except OSError:
        return False


def launcher_of(pid: int) -> Launcher | None:
    """How the app was started, when that is one of the ways known."""
    try:
        program = os.readlink(f"/proc/{pid}/exe")
    except OSError:
        return None
    for launcher in LAUNCHERS:
        found = re.fullmatch(launcher.program, program)
        if found and os.path.exists(found.expand(launcher.script)):
            return launcher
    return None


def set_setting(path: str, name: str, value: str) -> bool:
    """Adds a setting to a settings file of VS Code, unless the file says
    something about it already. The file may hold comments, so it is not
    written anew: the setting goes in after the opening brace."""
    try:
        text = Path(path).read_text() if os.path.exists(path) else ""
        if f'"{name}"' in text:
            return True
        blank = r"(?:\s|//[^\n]*\n|/\*.*?\*/)*"
        opening = re.match(blank + r"\{", text, re.S)
        setting = f"\n  {json.dumps(name)}: {json.dumps(value)}"
        if opening:
            rest = text[opening.end():]
            text = text[:opening.end()] + setting + ("" if re.match(blank + r"\}", rest, re.S) else ",") + rest
        elif not text.strip():
            text = "{" + setting + "\n}\n"
        else:
            return False
        os.makedirs(os.path.dirname(path), exist_ok=True)
        Path(path).write_text(text)
        return True
    except OSError as error:
        log.debug("could not write %s: %s", path, error)
        return False


def set_up(launcher: Launcher) -> bool:
    """Has the app start with the flag from now on."""
    if not add_flag(config_path(launcher.flags)):
        return False
    return launcher.setting is None or set_setting(config_path(launcher.setting[0]), *launcher.setting[1:])


def has_flag(path: str) -> bool:
    try:
        return ACCESSIBILITY_FLAG in (line.strip() for line in Path(path).read_text().splitlines())
    except OSError:
        return False


def add_flag(path: str) -> bool:
    """Adds the flag to the file, on a line of its own, unless it is there."""
    try:
        lines = Path(path).read_text().splitlines() if os.path.exists(path) else []
        if not has_flag(path):
            os.makedirs(os.path.dirname(path), exist_ok=True)
            Path(path).write_text("\n".join(lines + [ACCESSIBILITY_FLAG]) + "\n")
        return True
    except OSError as error:
        log.debug("could not write %s: %s", path, error)
        return False


def owners(batch: Batch, names: list[str], pid: int) -> list[str]:
    """The bus names that belong to the process."""
    owned: list[str] = []

    def keep(name: str, reply: tuple | None) -> None:
        if reply and reply[0] == pid:
            owned.append(name)

    for name in names:
        batch.call(DBUS, DBUS.bus, "GetConnectionUnixProcessID", GLib.Variant("(s)", (name,)), partial(keep, name))
    batch.wait()
    return owned


# --- Accessibility tree ------------------------------------------------------


def _children(node: Node, reply: tuple | None) -> None:
    if reply:
        node.children = [Ref(*child) for child in reply[0]]


def _role(node: Node, reply: tuple | None) -> None:
    if reply:
        node.role = reply[0]


def _state(node: Node, reply: tuple | None) -> None:
    if reply:
        low, high = reply[0]
        node.state = low | high << 32


def _name(node: Node, reply: tuple | None) -> None:
    if reply:
        node.name = reply[0]


def _actions(node: Node, reply: tuple | None) -> None:
    if reply:
        node.actions = len(reply[0])
        if reply[0] and not node.key:
            node.key = reply[0][0][2]


def _key(node: Node, reply: tuple | None) -> None:
    if reply and reply[0]:
        node.key = reply[0]


def _press(node: Node, reply: tuple | None) -> None:
    if reply:
        node.press = reply[0]


class Tree:
    """The accessibility tree of one app."""

    def __init__(self, batch: Batch, qt: bool = False, chromium: bool = False):
        self.batch = batch
        # Chromium, and so Electron, keeps its interface to itself unless it
        # is started with --force-renderer-accessibility.
        self.chromium = chromium
        # Qt leaves the shortcut out of the action list and gives it only
        # when asked: a second call per node, so not sent to other toolkits.
        self.qt = qt

    def fetch(self, refs: list[Ref], *, children: bool = False, role: bool = False, state: bool = False,
              name: bool = False, actions: bool = False, press: bool = False) -> dict[Ref, Node]:
        """A node for every ref, with what was asked for, all asked at once."""
        nodes = {ref: Node() for ref in refs}
        call = self.batch.call
        for ref, node in nodes.items():
            if children:
                call(ref, ACCESSIBLE, "GetChildren", None, partial(_children, node))
            if role:
                call(ref, ACCESSIBLE, "GetRole", None, partial(_role, node))
            if state:
                call(ref, ACCESSIBLE, "GetState", None, partial(_state, node))
            if name:
                call(ref, PROPERTIES, "Get", GLib.Variant("(ss)", (ACCESSIBLE, "Name")), partial(_name, node))
            if actions:
                call(ref, ACTION, "GetActions", None, partial(_actions, node))
                if self.qt:
                    call(ref, ACTION, "GetKeyBinding", GLib.Variant("(i)", (0,)), partial(_key, node))
            if press:
                # Chromium leaves the names out of the action list too.
                call(ref, ACTION, "GetName", GLib.Variant("(i)", (0,)), partial(_press, node))
        self.batch.wait()
        return nodes


def app_frames(batch: Batch, pid: int) -> tuple[Tree, dict[Ref, Node]]:
    """The app's tree and its windows."""
    apps = Tree(batch).fetch([REGISTRY], children=True)[REGISTRY].children
    by_bus = {ref.bus: ref for ref in apps}
    # Only our own app is asked anything more: another one that hangs must not hold us up.
    own = [by_bus[bus] for bus in owners(batch, list(by_bus), pid)]

    toolkits: list[str] = []
    for ref in own:
        batch.call(ref, PROPERTIES, "Get", GLib.Variant("(ss)", (APPLICATION, "ToolkitName")),
                   lambda reply: toolkits.append(reply[0]) if reply else None)
    batch.wait()

    tree = Tree(batch, qt="Qt" in toolkits, chromium="Chromium" in toolkits)
    frames = [frame for node in tree.fetch(own, children=True).values() for frame in node.children]
    log.debug("accessibility: %d app object(s), toolkit %s, %d frame(s)", len(own), toolkits or "?", len(frames))
    return tree, tree.fetch(frames, children=True, role=True, state=True, name=True)


def choose_frames(frames: dict[Ref, Node], title: str) -> tuple[list[Ref], str]:
    """The frames that could be the focused window, and why its items must not
    be run ("" when they may).

    The open menu holds the keyboard, so the app's frame is usually not marked
    active any more and its title has to do. Two frames with the focused
    window's title cannot be told apart: one of them is read, so its items can
    be seen, but none is run, since it could be the other window's.
    """
    active = [ref for ref, node in frames.items() if node.has(ACTIVE)]
    if active:
        return active[:1], ""
    titled = [ref for ref, node in frames.items() if title and node.name == title]
    if titled:
        return titled[:1], SAME_TITLE if len(titled) > 1 else ""
    # No frame carries the title: fine when only one of them could be meant.
    return list(frames), ""


def find_menubar(tree: Tree, frame: Ref, node: Node, deadline: float) -> Ref | None:
    level = [(frame, node)]
    for _ in range(10):
        below: list[Ref] = []
        for ref, current in level:
            if current.role == MENU_BAR:
                return ref
            if current.role not in CONTENT_ROLES:
                below.extend(current.children)
        if not below or time.monotonic() > deadline:
            return None
        level = list(tree.fetch(below[:MAX_NODES], children=True, role=True).items())
    return None


class Window(NamedTuple):
    frame: Ref | None  # None when it could not be told which frame it is
    menubar: Ref | None
    why: str


def pick_window(tree: Tree, frames: dict[Ref, Node], title: str, deadline: float) -> Window:
    candidates, why = choose_frames(frames, title)
    with_menu = []
    for ref in candidates:
        menubar = find_menubar(tree, ref, frames[ref], deadline)
        if menubar is not None:
            with_menu.append((ref, menubar))
    if len(with_menu) == 1:
        return Window(with_menu[0][0], with_menu[0][1], why)
    if len(candidates) == 1:
        return Window(candidates[0], None, why)
    return Window(None, None, why)


def menu_items(nodes: dict[Ref, Node], menu: Ref, path: tuple[str, ...] = ()) -> Iterator[tuple[list[str], Ref, Node]]:
    """Every item below `menu` in the app's order, with the menus it is in."""
    for child in nodes[menu].children:
        node = nodes.get(child)
        if node is None:
            continue
        if node.role == POPUP_MENU:
            # Qt hangs a submenu's items off an unnamed popup under the item.
            yield from menu_items(nodes, child, path)
        elif node.role == MENU or (node.role in ITEM_ROLES and node.children):
            if node.label:
                yield from menu_items(nodes, child, path + (node.label,))
        elif node.role in ITEM_ROLES and node.label:
            yield list(path), child, node


def read_menu(tree: Tree, menubar: Ref, entries: Entries, deadline: float, why: str) -> None:
    """The whole menu bar, a level at a time."""
    nodes = tree.fetch([menubar], children=True)
    level = nodes[menubar].children
    depth = 0
    while level and depth <= MAX_DEPTH and len(nodes) < MAX_NODES and time.monotonic() < deadline:
        fetched = tree.fetch(level, children=True, role=True, state=True, name=True, actions=True)
        nodes.update(fetched)
        if depth == 0:
            # The top-level names are enough to show the menu; the rest follows.
            entries.emit({"t": "sections", "names": [fetched[ref].label for ref in level if fetched[ref].label]})
        level = [child for ref in level for child in fetched[ref].children if child not in nodes]
        depth += 1

    for path, ref, node in menu_items(nodes, menubar):
        entries.add(path, node.label, "menu", Press(ref), key=shortcut(node.key),
                    enabled=node.usable, checked=node.has(CHECKED), why=why)
    sent = entries.flush()
    log.debug("menu bar: %d node(s), %d level(s), %d item(s)", len(nodes), depth, sent)


def text_in(nodes: dict[Ref, Node], ref: Ref) -> str:
    """The first plain text below `ref`; what a control says is its own."""
    node = nodes.get(ref)
    if node is None or node.role in CONTROL_ROLES:
        return ""
    if node.role in TEXT_ROLES and node.label:
        return node.label
    return next(filter(None, (text_in(nodes, child) for child in node.children)), "")


def place_buttons(buttons: list[Entry], nodes: dict[Ref, Node], parents: dict[Ref, Ref]) -> None:
    """Says which part of the window a button is in, where the window has
    several parts alike: the More options of one pane from that of the next.

    Buttons with one label show where such parts are. The part of each is
    what it does not share with its namesakes, and is called by the nearest
    text in it: for a pane, its title. Every other button in that part is
    placed there too. Parts with one title are numbered in the window's order.
    """
    above: dict[int, list[Ref]] = {}
    for button in buttons:
        chain, ref = [], parents.get(button.target.ref)
        while ref is not None:
            chain.append(ref)
            ref = parents.get(ref)
        above[button.id] = chain

    # Buttons are read a level at a time; the window's own order is top-down.
    order: dict[Ref, int] = {}
    stack = [ref for ref in nodes if ref not in parents]
    while stack:
        ref = stack.pop()
        if ref not in order:
            order[ref] = len(order)
            stack.extend(reversed(nodes[ref].children if ref in nodes else []))

    by_label: dict[str, list[Entry]] = {}
    for button in sorted(buttons, key=lambda button: order.get(button.target.ref, 0)):
        by_label.setdefault(button.label, []).append(button)
    parts: dict[Ref, str] = {}
    titled: dict[str, int] = {}
    # The label seen most often shows the most parts, so it names them first.
    for namesakes in sorted(by_label.values(), key=len, reverse=True):
        if len(namesakes) < 2:
            break
        shared: dict[Ref, int] = {}
        for button in namesakes:
            for ref in above[button.id]:
                shared[ref] = shared.get(ref, 0) + 1
        for button in namesakes:
            own = [ref for ref in above[button.id] if shared[ref] == 1]
            title = next(filter(None, (text_in(nodes, ref) for ref in own)), "")
            if not title or any(ref in parts for ref in above[button.id]):
                continue
            titled[title] = titled.get(title, 0) + 1
            parts[own[-1]] = title if titled[title] == 1 else f"{title} {titled[title]}"

    for button in buttons:
        button.place = next((parts[ref] for ref in above[button.id] if ref in parts), "")


def read_controls(tree: Tree, frame: Ref, entries: Entries, deadline: float, why: str, content: bool = False) -> int:
    """The window's named buttons; says how many. Page content is left out
    unless asked for."""
    level = [frame]
    pages: dict[Ref, Ref] = {}  # the web page each node of one is on
    known = {entry.target.ref for entry in entries.all if isinstance(entry.target, Press)}
    nodes: dict[Ref, Node] = {}
    parents: dict[Ref, Ref] = {}
    first = len(entries.all)
    seen = 0
    for _ in range(30):
        if not level or seen >= MAX_NODES or time.monotonic() > deadline:
            break
        level = level[: MAX_NODES - seen]
        seen += len(level)
        fetched = tree.fetch(level, children=True, role=True, state=True, name=True)
        nodes.update(fetched)
        controls = [ref for ref in level
                    if fetched[ref].role in CONTROL_ROLES and fetched[ref].label and fetched[ref].has(SHOWING)]
        acting = tree.fetch(controls, actions=True)

        below: list[Ref] = []
        for ref in level:
            node = fetched[ref]
            if node.role in CONTENT_ROLES and not content:
                continue
            page = pages.get(ref) or (ref if node.role == WEB_PAGE else None)
            if ref in acting:
                node.key, node.actions = acting[ref].key, acting[ref].actions
                if node.usable and ref not in known:
                    label, key = split_shortcut(node.label) if page is not None else (node.label, "")
                    entries.add([], label, "button", Press(ref, page), key=shortcut(node.key) or key,
                                checked=node.has(CHECKED) or node.has(PRESSED), why=why)
            if page is not None:
                pages.update((child, page) for child in node.children)
            parents.update((child, ref) for child in node.children)
            below.extend(node.children)
        level = below

    place_buttons(entries.all[first:], nodes, parents)
    found = entries.flush()
    log.debug("buttons%s: %d node(s), %d button(s)", " with page content" if content else "", seen, found)
    return found


# --- Menus a page draws when asked ------------------------------------------


def takes_click(node: Node) -> bool:
    # A page calls it "click" on what listens for one itself, and
    # "clickAncestor" on what merely sits inside such a thing.
    return node.actions > 0 and (node.role in CONTROL_ROLES or node.press == "click")


def text_of(nodes: dict[Ref, Node], ref: Ref) -> str:
    """Its name, or else the text inside it."""
    node = nodes.get(ref)
    if node is None:
        return ""
    return node.name or " ".join(filter(None, (text_of(nodes, child) for child in node.children)))


def choices(nodes: dict[Ref, Node], ref: Ref) -> Iterator[tuple[Ref, str, Node]]:
    """What can be chosen below `ref`, in the page's order: the innermost
    things that take a click, named by the text in them. A page seldom gives
    its own menus the roles of one, so the roles are not asked."""
    node = nodes.get(ref)
    if node is None:
        return
    inner = [choice for child in node.children for choice in choices(nodes, child)]
    if inner:
        yield from inner
    elif takes_click(node) and clean(text_of(nodes, ref)):
        yield ref, clean(text_of(nodes, ref)), node


def read_drawn(tree: Tree, roots: list[Ref], deadline: float, menu: bool) -> list[tuple[Ref, str, Node]]:
    """The choices of what a page has just drawn; none when that is not a
    menu. `menu` says the page calls it one itself, and is taken at its word."""
    nodes: dict[Ref, Node] = {}
    level = roots
    while level and len(nodes) < MENU_NODES and time.monotonic() < deadline:
        fetched = tree.fetch(level, children=True, role=True, state=True, name=True, actions=True, press=True)
        nodes.update(fetched)
        level = [child for ref in level for child in fetched[ref].children if child not in nodes]
    found = [choice for root in roots for choice in choices(nodes, root)]
    if menu:
        return found
    if any(node.role in FORM_ROLES for node in nodes.values()):
        return []
    # One thing to click is a notice, not a menu.
    return found if len(found) > 1 else []


def walk(tree: Tree, root: Ref, deadline: float) -> tuple[dict[Ref, Node], dict[Ref, Ref]]:
    """Every node below `root` with its role, and the parent of each."""
    nodes: dict[Ref, Node] = {}
    parents: dict[Ref, Ref] = {}
    level = [root]
    while level and len(nodes) < MAX_NODES and time.monotonic() < deadline:
        fetched = tree.fetch(level, children=True, role=True)
        nodes.update(fetched)
        below = []
        for ref in level:
            for child in fetched[ref].children:
                if child not in nodes and child not in parents:
                    parents[child] = ref
                    below.append(child)
        level = below
    return nodes, parents


def drawn_menus(nodes: dict[Ref, Node], parents: dict[Ref, Ref], before: set[Ref], page: Ref) -> tuple[list[Ref], bool]:
    """What a page has drawn since `before` that may be a menu, and whether
    the page calls it one.

    A page that says what its menus are (VS Code) draws them anywhere, and is
    believed. One that does not (Obsidian) adds a menu as a new layer over
    everything else, a child of the page itself: only that is looked at, so a
    panel that opens somewhere inside the page is not taken for a menu.
    """
    fresh = [ref for ref in nodes if ref not in before]
    menus = {ref for ref in fresh if nodes[ref].role in MENU_ROLES}

    def inside_another(ref: Ref) -> bool:
        ref = parents.get(ref)
        while ref is not None and ref not in before:
            if ref in menus:
                return True
            ref = parents.get(ref)
        return False

    outer = [ref for ref in fresh if ref in menus and not inside_another(ref)]
    if outer:
        return outer, True
    return [ref for ref in fresh if parents.get(ref) == page], False


@dataclass
class Opened:
    """A menu an app drew because we pressed its button: what was drawn, each
    with what it was drawn in."""

    drawn: list[tuple[Ref, Ref]]


def still_up(tree: Tree, opened: list[Opened]) -> bool:
    """Whether any of the menus is still drawn."""
    holders = tree.fetch(list({parent for menu in opened for parent, _ in menu.drawn}), children=True)
    return any(ref in holders[parent].children for menu in opened for parent, ref in menu.drawn)


def open_menu(tree: Tree, entry: Entry, entries: Entries, up: list[Opened]) -> tuple[Opened | None, str]:
    """Presses the entry and adds the menu that draws, if one does. Gives the
    menu, or None when the press did something else, and why it failed.

    `up` are the menus already open: once a press has closed them it was a
    choice in one, and there is no more to wait for.
    """
    press: Press = entry.target
    connection = tree.batch.connection
    before = set(walk(tree, press.page, time.monotonic() + READ_BUDGET)[0])
    answer: list[str] = []

    def pressed(connection, result):
        try:
            if not connection.call_finish(result).unpack()[0]:
                answer.append("the app refused that action")
        except GLib.Error as error:
            # What opens a dialog may only answer once it is closed.
            if not error.matches(Gio.io_error_quark(), Gio.IOErrorEnum.TIMED_OUT):
                answer.append(error.message)

    connection.call(press.ref.bus, press.ref.path, ACTION, "DoAction", GLib.Variant("(i)", (0,)),
                    GLib.VariantType("(b)"), Gio.DBusCallFlags.NONE, RUN_TIMEOUT, None, pressed)

    started = time.monotonic()
    while time.monotonic() < started + MENU_WAIT and not answer:
        time.sleep(MENU_POLL)
        if up and not still_up(tree, up):
            break
        nodes, parents = walk(tree, press.page, started + MENU_WAIT)
        roots, menu = drawn_menus(nodes, parents, before, press.page)
        if not roots:
            # Nothing like a menu this long after the press: it was a plain button.
            if time.monotonic() > started + LAYER_WAIT:
                break
            continue
        # A menu still being drawn is read again until it has its items.
        found = read_drawn(tree, roots, time.monotonic() + MENU_WAIT, menu)
        if found:
            for ref, text, node in found:
                label, key = split_shortcut(text)
                entries.add(entry.path + [entry.label], label, "menu", Press(ref, press.page), key=key,
                            enabled=node.usable, checked=node.has(CHECKED), why=entry.why)
            log.debug("menu of %r: %d part(s), %d item(s), %.0f ms", entry.label, len(roots), len(found),
                      (time.monotonic() - started) * 1000)
            return Opened([(parents[ref], ref) for ref in roots]), ""
    log.debug("%r opened no menu%s", entry.label, f": {answer[0]}" if answer else "")
    return None, answer[0] if answer else ""


def send_escape(address: str) -> None:
    lua = f"hl.dispatch(hl.dsp.send_shortcut({{ mods = '', key = 'Escape', window = 'address:{address}' }}))"
    try:
        subprocess.run(["hyprctl", "eval", lua], capture_output=True, check=False, timeout=3)
    except (OSError, subprocess.TimeoutExpired) as error:
        log.debug("hyprctl eval failed: %s", error)


def close_menus(tree: Tree, address: str, opened: list[Opened]) -> None:
    """Closes the menus we had the app draw, so it is left as it was found.

    Nothing in the accessibility tree closes a menu, so the window is sent an
    Escape, as many times as it has menus up. None is sent once they are gone:
    it would land on the app itself.
    """
    if not re.fullmatch(r"0x[0-9a-f]+", address):
        return
    for _ in opened:
        if not still_up(tree, opened):
            break
        send_escape(address)
        time.sleep(ESCAPE_WAIT)
    opened.clear()


# --- GTK actions over D-Bus --------------------------------------------------


def action_root(identity: str) -> str:
    """"/org/gnome/Nautilus" from "org.gnome.Nautilus"."""
    return "/" + identity.replace(".", "/").replace("-", "_")


def action_groups(root: str, windows: list[str]) -> list[tuple[str, str]]:
    """(path, why not to run) for the app's own action group and its windows'.

    Actions are exported once per window, and D-Bus does not say which window
    is the focused one. With one window they are its; with several they are
    still listed, from the first, but not run: the wrong window could take it.
    """
    groups = [(root, "")]
    if windows:
        groups.append((f"{root}/window/{sorted(windows)[0]}", SEVERAL_WINDOWS if len(windows) > 1 else ""))
    return groups


def action_sources(owned: list[str], app_id: str) -> list[tuple[str, str]]:
    """(bus name, action root) to look under.

    An app's first process owns its name ("org.gnome.Nautilus") and the
    actions live under it. A further process of the same app has only its
    connection (":1.140"); its actions are at the same path, which the
    window's app id gives.
    """
    sources = [(name, action_root(name)) for name in sorted(owned) if not name.startswith(":")]
    if "." in app_id:
        sources += [(name, action_root(app_id)) for name in sorted(owned) if name.startswith(":")]
    return sources


def window_names(xml: str) -> list[str]:
    try:
        return [node.get("name") or "" for node in ElementTree.fromstring(xml).findall("node")]
    except ElementTree.ParseError:
        return []


def read_gtk_actions(session: Gio.DBusConnection, pid: int, app_id: str, entries: Entries) -> None:
    batch = Batch(session, ACTIONS_TIMEOUT)
    names: list[str] = []
    batch.call(DBUS, DBUS.bus, "ListNames", None, lambda reply: names.extend(reply[0]) if reply else None)
    batch.wait()
    owned = owners(batch, [name for name in names if not name.startswith("org.freedesktop.")], pid)
    sources = action_sources(owned, app_id)

    windows: dict[tuple[str, str], list[str]] = {}
    for bus, root in sources:
        batch.call(Ref(bus, root + "/window"), INTROSPECTABLE, "Introspect", None,
                   lambda reply, key=(bus, root): windows.update({key: window_names(reply[0])}) if reply else None)
    batch.wait()

    groups = [(bus, path, why) for bus, root in sources for path, why in action_groups(root, windows.get((bus, root), []))]
    described: dict[tuple[str, str], dict] = {}
    for bus, path, _ in groups:
        batch.call(Ref(bus, path), GTK_ACTIONS, "DescribeAll", None,
                   lambda reply, key=(bus, path): described.update({key: reply[0]}) if reply else None)
    batch.wait()

    seen: set[str] = set()
    for bus, path, why in groups:
        for action, (enabled, parameter_type, state) in sorted(described.get((bus, path), {}).items()):
            # Actions that need an argument cannot be run from a plain list.
            if parameter_type or action in seen:
                continue
            seen.add(action)
            entries.add([], humanize(action), "action", GtkAction(bus, path, action),
                        enabled=enabled, checked=bool(state) and state[0] is True, why=why)
    sent = entries.flush()
    log.debug("gtk actions: %d bus name(s), %d group(s), %d action(s)", len(owned), len(groups), sent)


# --- Reading and running -----------------------------------------------------


def read(window: dict, session: Gio.DBusConnection, accessibility: Gio.DBusConnection | None, emit: Emit) -> Entries:
    """Sends every entry of the window, then how it went."""
    entries = Entries(emit)
    pid = window.get("pid")
    if not pid:
        emit({"t": "done", "status": "no-window"})
        return entries
    started = time.monotonic()

    tree = None
    found = Window(None, None, "")
    if accessibility is not None:
        tree, frames = app_frames(Batch(accessibility), pid)
        found = pick_window(tree, frames, window.get("title") or "", time.monotonic() + READ_BUDGET)
        log.debug("window: frame %s, menu bar %s%s", found.frame and found.frame.path,
                  found.menubar and found.menubar.path, f" ({found.why})" if found.why else "")
        if found.menubar is not None:
            read_menu(tree, found.menubar, entries, time.monotonic() + READ_BUDGET, found.why)
    has_menu = bool(entries.all)

    if tree is None or not tree.qt:
        read_gtk_actions(session, pid, window.get("class") or "", entries)

    if tree is not None and found.frame is not None and not has_menu:
        deadline = time.monotonic() + READ_BUDGET
        buttons = read_controls(tree, found.frame, entries, deadline, found.why)
        # An Electron app draws its whole interface as a web page. Around it
        # there is nothing, or the buttons of a window frame; a browser has a
        # toolbar there, and its page is not its own.
        if (not buttons and not entries.all) or (tree.chromium and buttons <= FRAME_BUTTONS):
            read_controls(tree, found.frame, entries, deadline, found.why, content=True)

    if entries.all:
        status = "ok"
    elif not accessibility_enabled(session):
        status = "accessibility-off"
    else:
        status = "needs-flag" if tree is not None and tree.chromium and not flag_set(pid) else "empty"
    log.debug("%d entries, %s, %.0f ms", len(entries.all), status, (time.monotonic() - started) * 1000)
    done = {"t": "done", "status": status}
    launcher = launcher_of(pid) if status == "needs-flag" else None
    if launcher is not None:
        # The menu offers to set the flag there; once it is, the app only
        # has to be started again.
        path = config_path(launcher.flags)
        done.update(file=path.replace(os.path.expanduser("~"), "~", 1), note=launcher.note, set=has_flag(path))
    emit(done)
    return entries


def run(entry: Entry, session: Gio.DBusConnection, accessibility: Gio.DBusConnection | None) -> str:
    """Empty when it worked, else why it did not."""
    if not entry.runnable:
        return "that entry is not available"
    target = entry.target
    try:
        if isinstance(target, GtkAction):
            session.call_sync(
                target.bus, target.path, GTK_ACTIONS, "Activate",
                GLib.Variant("(sava{sv})", (target.name, [], {})),
                None, Gio.DBusCallFlags.NONE, RUN_TIMEOUT, None,
            )
            return ""
        if accessibility is None:
            return "the accessibility bus is gone"
        accepted = accessibility.call_sync(
            target.ref.bus, target.ref.path, ACTION, "DoAction", GLib.Variant("(i)", (0,)),
            GLib.VariantType("(b)"), Gio.DBusCallFlags.NONE, RUN_TIMEOUT, None,
        ).unpack()[0]
        return "" if accepted else "the app refused that action"
    except GLib.Error as error:
        # An item that opens a dialog may only answer once it is closed.
        if error.matches(Gio.io_error_quark(), Gio.IOErrorEnum.TIMED_OUT):
            return ""
        return error.message


def parse_command(line: str) -> tuple[str, int]:
    """("run", id), ("open", id), ("back", 0), ("accessibility", 0),
    ("flag", 0), or ("", 0) for anything else."""
    words = line.split()
    if len(words) == 2 and words[0] in ("run", "open") and words[1].isdigit():
        return words[0], int(words[1])
    if words in (["accessibility"], ["back"], ["flag"]):
        return words[0], 0
    return "", 0


def serve(entries: Entries, window: dict, session: Gio.DBusConnection,
          accessibility: Gio.DBusConnection | None) -> None:
    """Runs the commands SearchMenuItems.qml writes to stdin, until it closes it."""
    loop = GLib.MainLoop()
    tree = Tree(Batch(accessibility)) if accessibility is not None else None
    address = str(window.get("address") or "")
    opened: list[Opened] = []  # the menus the app has up because of us
    running = False

    def run_entry(entry_id: int) -> bool:
        error = run(entries.all[entry_id], session, accessibility) if entry_id < len(entries.all) else "that entry is gone"
        # A menu goes away with the choice made in it.
        opened.clear()
        entries.emit({"t": "ran", "error": error})
        loop.quit()
        return False

    def open_entry(entry_id: int) -> bool:
        """Whether a menu opened; the entry has run all the same when not."""
        entry = entries.all[entry_id] if entry_id < len(entries.all) else None
        if entry is None or tree is None or not entry.opens or not entry.runnable:
            entries.emit({"t": "pressed", "error": "that entry is not available"})
            return False
        menu, error = open_menu(tree, entry, entries, opened)
        if menu is None:
            entries.emit({"t": "pressed", "error": error})
            return False
        opened.append(menu)
        entries.emit({"t": "menu", "path": entry.path + [entry.label],
                      "items": [item.message() for item in entries.fresh()]})
        return True

    def stopped() -> bool:
        # The menu closes as it asks for a run, and stops us with it: that
        # must not lose the run.
        if not running:
            loop.quit()
        return True

    def command(_source, condition) -> bool:
        nonlocal running
        line = sys.stdin.readline() if condition & GLib.IOCondition.IN else ""
        if not line:
            loop.quit()
            return False
        name, entry_id = parse_command(line)
        if name == "run":
            # It waits a moment, so the app has the focus back.
            running = True
            GLib.timeout_add(RUN_DELAY, run_entry, entry_id)
            return False
        if name == "open" and not open_entry(entry_id):
            loop.quit()
            return False
        if name == "back" and tree is not None:
            close_menus(tree, address, opened)
        if name == "accessibility":
            enable_accessibility()
            entries.emit({"t": "accessibility", "on": accessibility_enabled(session)})
        if name == "flag":
            launcher = launcher_of(window.get("pid") or 0)
            entries.emit({"t": "flag", "on": launcher is not None and set_up(launcher)})
        return True

    unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, stopped)
    GLib.io_add_watch(sys.stdin.fileno(), GLib.PRIORITY_DEFAULT,
                      GLib.IOCondition.IN | GLib.IOCondition.HUP, command)
    GLib.timeout_add_seconds(IDLE_TIMEOUT, loop.quit)
    loop.run()
    if tree is not None:
        close_menus(tree, address, opened)


def print_entries(entries: Entries) -> None:
    for entry in entries.all:
        label = " > ".join(entry.path + [entry.label])
        print("\t".join(part for part in (label, entry.key, "" if entry.runnable else "off") if part))


def main() -> int:
    parser = argparse.ArgumentParser(description="Read what a window can do, and run one of the entries in its app.")
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--serve", action="store_true", help="entries as JSON lines on stdout, commands on stdin")
    mode.add_argument("--print", action="store_true", help="list the entries")
    parser.add_argument("--window", default="", metavar="ADDRESS", help="a Hyprland window address; the focused window otherwise")
    parser.add_argument("--debug", action="store_true", help="say on stderr what was found where")
    options = parser.parse_args()
    logging.basicConfig(stream=sys.stderr, format="%(name)s: %(message)s",
                        level=logging.DEBUG if options.debug else logging.WARNING)

    window = find_window(options.window)
    log.debug("window: %s pid %s %r", window.get("class"), window.get("pid"), window.get("title"))
    session = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    try:
        accessibility = accessibility_bus(session)
    except GLib.Error as error:
        log.debug("no accessibility bus: %s", error.message)
        accessibility = None

    if options.print:
        print_entries(read(window, session, accessibility, to_nowhere))
        return 0

    to_stdout({"t": "window", "class": window.get("class") or "", "title": window.get("title") or ""})
    serve(read(window, session, accessibility, to_stdout), window, session, accessibility)
    return 0


if __name__ == "__main__":
    sys.exit(main())
